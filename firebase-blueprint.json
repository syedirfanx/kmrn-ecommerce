{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store item available for purchase with clean specifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "subcategory": { "type": "string", "maxLength": 80 },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "details": { "type": "string", "maxLength": 2000 },
        "specs": { "type": "array" },
        "image": { "type": "string", "maxLength": 1000 },
        "additionalImages": { "type": "array" },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "price", "description", "image"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Store primary category (up to 5 categories)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "logo": { "type": "string" },
        "order": { "type": "number" },
        "locked": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "Catalogue": {
      "title": "Catalogue",
      "description": "Product collection / designer catalogue assigned to a category in 16:9 banner format",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 80 },
        "order": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "image", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order placed with Cash on Delivery",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "userId": { "type": "string" },
        "placedAt": { "type": "string" }
      },
      "required": ["orderId", "customerName", "phone", "email", "total", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with contact info, delivery address and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "district": { "type": "string" },
        "subDistrict": { "type": "string" },
        "street": { "type": "string" },
        "address": { "type": "string" },
        "deliveryZone": { "type": "string" },
        "preferredPaymentMethod": { "type": "string" },
        "preferredBkashNumber": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Item in user shopping cart",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productId", "quantity", "userId"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "FeaturedSettings": {
      "title": "FeaturedSettings",
      "description": "Featured products selected to appear on the homepage (up to 4)",
      "type": "object",
      "properties": {
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productIds"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer inquiry submitted via contact form, visible and manageable by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "message"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog products with up to 10 specs, manageable by admin"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryItem",
      "description": "Store categories, fully manageable by admin"
    },
    "/catalogues/{catalogueId}": {
      "schema": "Catalogue",
      "description": "Designer catalogues & collections per category, in 16:9 banner showcase format"
    },
    "/settings/{settingId}": {
      "schema": "FeaturedSettings",
      "description": "Site configurations including featured homepage products, banner slides, and scheduled offers"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Customer inquiry messages submitted via contact form, readable and deletable by admin"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Central customer orders, manageable by admin with status tracking and Excel export"
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": "CartItem",
      "description": "User shopping cart items, private to each user"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Admin authorization mapping"
    }
  }
}
