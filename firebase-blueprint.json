{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store item available for purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "subcategory": { "type": "string", "maxLength": 80 },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "details": { "type": "string", "maxLength": 2000 },
        "image": { "type": "string", "maxLength": 1000 },
        "additionalImages": { "type": "array" },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "price", "description", "image"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Product category and its subcategories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 80 },
        "subcategories": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Item in user shopping cart",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productId", "quantity", "userId"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "FeaturedSettings": {
      "title": "FeaturedSettings",
      "description": "Featured products selected to appear on the homepage",
      "type": "object",
      "properties": {
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productIds"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer message submitted via the contact form",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog products, manageable by admin"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryItem",
      "description": "Store categories and subcategories, manageable by admin"
    },
    "/settings/{settingId}": {
      "schema": "FeaturedSettings",
      "description": "Site configurations including featured 4 home products, banner slides, and announcements"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Customer inquiry messages submitted via contact form, visible to admin"
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": "CartItem",
      "description": "User shopping cart items, private to each user"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Admin authorization mapping"
    }
  }
}
