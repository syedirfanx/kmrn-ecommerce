{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store item available for purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "subcategory": { "type": "string", "maxLength": 80 },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "details": { "type": "string", "maxLength": 2000 },
        "image": { "type": "string", "maxLength": 1000 },
        "additionalImages": { "type": "array" },
        "inStock": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "price", "description", "image"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Product category and its subcategories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 80 },
        "subcategories": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Item in user shopping cart",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productId", "quantity", "userId"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog products, manageable by admin"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryItem",
      "description": "Store categories and subcategories, manageable by admin"
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": "CartItem",
      "description": "User shopping cart items, private to each user"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Admin authorization mapping"
    }
  }
}
