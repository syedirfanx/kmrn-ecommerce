rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'syed111042@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products catalog & product reviews
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(productId);

      // Customer reviews
      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isValidId(reviewId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Categories and subcategories
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Site settings (such as featured banner product selection)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // User data: profile, cart, wishlist, orders (strictly private to each user)
    match /users/{userId}/{document=**} {
      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Admin role mapping
    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && isValidId(userId);
    }
  }
}
