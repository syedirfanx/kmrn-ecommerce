rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'syed111042@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products catalog & product reviews
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(productId);

      // Customer reviews & ratings (user can post and delete own review)
      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isValidId(reviewId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Categories and subcategories (up to 5 categories, up to 10 subcategories)
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Site settings (featured homepage products, carousel banner slides, running news & offers)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Customer inquiries / messages from contact form (visible & manageable by admin)
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Central orders collection for admin management (active orders & order history)
    match /orders/{orderId} {
      allow create: if isValidId(orderId);
      allow get, list: if true;
      allow update, delete: if isValidId(orderId);
    }

    // User private data: profile, cart, wishlist, orders
    match /users/{userId}/{document=**} {
      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Admin authorization mapping
    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && isValidId(userId);
    }
  }
}
