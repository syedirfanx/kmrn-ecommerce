rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'syed111042@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products catalog & customer reviews
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(productId);

      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isValidId(reviewId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Store primary categories
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Catalogues collection (Women's Wear and seasonal designer catalogues)
    match /catalogues/{catalogueId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(catalogueId);
    }

    // Site settings (announcements, banner ads, featured items)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Promo codes collection
    match /promocodes/{promoId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(promoId);
    }

    // Customer inquiries / messages from contact form (live sync to Admin Portal)
    match /messages/{messageId} {
      allow get, list, create, update, delete: if true;
    }

    // Central orders collection (live sync for checkout and Admin Portal across all devices)
    match /orders/{orderId} {
      allow get, list, create, update, delete: if true;
    }

    // User private data: profile, cart, wishlist, orders
    match /users/{userId}/{document=**} {
      allow get, list, create, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Admin authorization mapping
    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && isValidId(userId);
    }
  }
}
